# ==============================================================================
# TradeMind-AI Configuration Template
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Project & Environment
PROJECT_NAME="TradeMind-AI (NIFTY 50 F&O)"
VERSION="2.0.0"
ENVIRONMENT="production"

# Currency & Market Setup (NSE / BSE - Indian Rupee)
CURRENCY_SYMBOL="₹"
CURRENCY_CODE="INR"

# Telegram Bot Integration (Optional: Real-time alerts & interactive commands)
# Create a bot via @BotFather on Telegram to get your token.
# Get your Chat ID by messaging @userinfobot on Telegram.
TELEGRAM_TOKEN="your_telegram_bot_token_here"
CHAT_ID="your_telegram_chat_id_here"

# Google Gemini AI Integration (Optional: LLM market reasoning & trade confirmation)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Virtual Paper Trading Portfolio (INR)
INITIAL_BALANCE=30000.0
MAX_POSITION_SIZE_RATIO=0.35
STOP_LOSS_PERCENT=0.015
TAKE_PROFIT_PERCENT=0.035

# Daily Risk Circuit Parameters (NIFTY F&O)
MAX_DAILY_TRADES=4
MAX_DAILY_LOSS=2000.0
MAX_DAILY_PROFIT=4000.0
NIFTY_LOT_SIZE=65
NIFTY_STRIKE_STEP=50
OPTION_STRIKE_TYPE="ITM"

# Strictly NIFTY 50 Index F&O Universe
DEFAULT_SYMBOLS="^NSEI"

# Autonomous Market Scanner Interval (Minutes)
SCAN_INTERVAL_MINUTES=15

# Database URL (Defaults to SQLite; supports PostgreSQL on Render)
# For SQLite: sqlite:///trademind.db
# For Render PostgreSQL: postgresql://username:password@host/database
DATABASE_URL="sqlite:///trademind.db"
AUTO_RESET_DB_ON_START="true"
AUTO_EOD_SQUARE_OFF="true"
EOD_SQUARE_OFF_TIME="15:25"
PRE_MARKET_RESET_TIME="09:00"

# Server Network Host & Port (Render dynamically assigns PORT)
API_HOST="0.0.0.0"
PORT=8000

